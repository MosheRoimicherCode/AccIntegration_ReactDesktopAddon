<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../AccIntegrationWPF/AccIntegration/AccIntegration.csproj" />
    <!-- Compile the real CLI boundaries without activating TerraExplorer COM. -->
    <Compile Include="../../AccIntegrationWPF/AccIntegrationCli/Output/*.cs" Link="Production/Output/%(Filename)%(Extension)" />
    <Compile Include="../../AccIntegrationWPF/AccIntegrationCli/Input/CliArguments.cs" Link="Production/CliArguments.cs" />
    <Compile Include="../../AccIntegrationWPF/AccIntegrationCli/CliApplication.cs" Link="Production/CliApplication.cs" />
    <Compile Include="../../AccIntegrationWPF/AccIntegrationCli/Commands/ICliCommand.cs" Link="Production/ICliCommand.cs" />
    <Compile Include="../../AccIntegrationWPF/AccIntegrationCli/Commands/WorkflowReporter.cs" Link="Production/WorkflowReporter.cs" />
    <Compile Include="../../AccIntegrationWPF/AccIntegrationCli/Commands/AccExtensionCommand.cs" Link="Production/AccExtensionCommand.cs" />
  </ItemGroup>
</Project>
